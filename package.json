    "builtin-modules": "^5.2.0",
    "commons": "file:../obsidian-commons",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "obsidian": "~1.14.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
