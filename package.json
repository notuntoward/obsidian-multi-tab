{
  "name": "obsidian-multi-tab",
  "version": "0.1.0",
  "description": "Select and manage multiple tabs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && npm test && npm run bundle",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run lint:community-review && npm run typecheck",
    "bundle": "node esbuild.config.mjs production",
    "lint:community-review": "eslint . --config eslint.community-review.config.mjs --max-warnings=0"
  },
  "keywords": [
    "obsidian",
    "obsidian-md",
    "obsidian-plugin"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "commons": "file:../obsidian-commons",
    "esbuild": "^0.28.2",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "jsdom": "^26.1.0",
    "obsidian": "~1.14.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
