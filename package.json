{
  "name": "obsidian-multi-tab",
  "version": "0.1.0",
  "description": "Select and manage multiple tabs in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
