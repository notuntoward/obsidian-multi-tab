{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "commonjs",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "obsidian": [
        "./node_modules/obsidian"
      ],
      "commons/*": [
        "../obsidian-commons/src/*/index.ts"
      ],
      "commons/internals": [
        "../obsidian-commons/src/internals.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}
